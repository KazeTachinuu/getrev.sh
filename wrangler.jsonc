{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "getrev-sh",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "getrev.sh",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
